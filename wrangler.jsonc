{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "workoutprogram",
  "main": "./worker.ts",
  "compatibility_date": "2026-09-20",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "MONGODB_DB_NAME": "workout_program"
  }
}
